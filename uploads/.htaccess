# Hanya benarkan gambar; jangan jalankan sebarang skrip dalam folder ini
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phar
<FilesMatch "\.(?i:php\d?|phtml|phar|pl|py|cgi|sh)$">
  Require all denied
</FilesMatch>
Options -Indexes -ExecCGI
